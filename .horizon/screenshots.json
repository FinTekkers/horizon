{
  "version": 1,
  "serve": "bash e2e/screenshots/serve.sh",
  "ready": "http://127.0.0.1:5480/",
  "outputDir": "e2e/__screenshots__/config",
  "themes": ["light", "dark"],
  "viewports": [
    {"name": "desktop", "width": 1024, "height": 640},
    {"name": "phone", "width": 375, "height": 667}
  ],
  "defaults": {"login": true},
  "screens": [
    {"name": "layout-board", "path": "/", "waitFor": ".card"},
    {"name": "layout-item-activity", "path": "/ls-log", "viewports": ["phone"], "themes": ["light"], "waitFor": ".activity-row"},
    {"name": "layout-item-badge", "path": "/ls-gate", "viewports": ["phone"], "themes": ["light"], "waitFor": ".tracker__meta .proj-badge"},
    {"name": "layout-admin-tokens", "path": "/admin/account", "viewports": ["phone"], "themes": ["light"], "waitFor": ".api-tokens"},
    {"name": "admin-sections", "path": "/admin", "themes": ["light"], "waitFor": ".admin-nav"},
    {"name": "autopilot-off-card", "path": "/", "viewports": ["desktop"], "waitFor": ".card .autopilot-off-chip"},
    {"name": "autopilot-off-item", "path": "/ap-364", "viewports": ["desktop"], "waitFor": ".autopilot-off-toggle input:checked"},
    {"name": "autopilot-off-approvals", "path": "/?approvals", "viewports": ["desktop"], "waitFor": ".approval .autopilot-off-note"},
    {"name": "journey-mock-agents", "path": "/js-mock", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"completed “Set guardrails”\")"},
    {"name": "journey-full-lifecycle", "path": "/js-closed", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".tracker__status:has-text(\"Closed\")"},
    {"name": "journey-gates", "path": "/js-gate", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"Reconsider the design options entirely.\")"},
    {"name": "journey-gate-key", "path": "/js-key", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"approved “Approve & prioritize this work”\")"},
    {"name": "journey-merge-conflict", "path": "/js-conflict", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".step-card__conflict:has-text(\"PR #501 has merge conflicts\")"},
    {"name": "journey-merge-resolved", "path": "/js-resolved", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"resolved 2 conflicted hunk(s) on PR #503\")"},
    {"name": "journey-abandon", "path": "/js-abandoned", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".tracker__actions:has-text(\"Superseded by a different approach\")"},
    {"name": "journey-artifact-history", "path": "/api/items/JS-HISTORY/artifacts/4", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".attempts:has-text(\"Add a third option with a cost comparison.\")"},
    {"name": "journey-login-error", "path": "/?error=google_link_blocked", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".gh-error", "login": false},
    {"name": "journey-queued-work", "path": "/js-queued", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".step-card--queued:has-text(\"waiting for a free agent slot (4/4 in use)\")"},
    {"name": "journey-markdown", "path": "/js-md", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".tracker__desc h5:has-text(\"Why this matters\")"},
    {"name": "journey-persona-picker", "path": "/js-persona", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"set the qa specialist persona to Data integrity\")"},
    {"name": "journey-premerge-red", "path": "/js-pmc", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row:has-text(\"failing tests (3):\")"},
    {"name": "journey-gate-blocked", "path": "/js-inflight", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".gate-action-status:has-text(\"Blocked: pre-merge check npm test failed\")"},
    {"name": "journey-gate-running", "path": "/js-running", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".gate-action-status:has-text(\"waiting for a capacity slot to run pre-merge checks (main + PR), 1 ahead\")", "mask": [".gate-action-status__elapsed"]},
    {"name": "journey-admin-projects", "path": "/admin", "viewports": ["desktop"], "themes": ["light"], "waitFor": "[aria-label=\"Journey screens project Autopilot history\"]:has-text(\"off → shadow\")"},
    {"name": "journey-definitions", "path": "/definitions", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".defs__item:has-text(\"journey-screens-project\")"},
    {"name": "journey-verify-fail", "path": "/js-verify", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".step:has-text(\"Command 1 crashed on import.\") .step__icon"},
    {"name": "journey-ran-ahead", "path": "/js-ran-ahead", "viewports": ["desktop", "phone"], "themes": ["light"], "waitFor": ".step-card__meta:has-text(\"Failed, sent back · attempt 1\")"},
    {"name": "journey-dependencies", "path": "/ls-blocked", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".dep-detail__id:has-text(\"LS-BLOCKER\")"},
    {"name": "journey-trivial-lane", "path": "/js-trivial", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".step-card:has-text(\"Skipped — trivial lane\")"},
    {"name": "journey-pause-reason", "path": "/js-paused", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".pause-banner:has-text(\"Auto-retried 2 times\")"},
    {"name": "journey-task-spawned", "path": "/js-task-spawn", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".dep-detail__section--spawned:has-text(\"JS-SPAWN-DONE\")"},
    {"name": "journey-task-first", "path": "/js-task-first", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"completed “Guardrails”\")"},
    {"name": "journey-task-planning", "path": "/js-task-plan", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"completed “Impact review”\")"},
    {"name": "journey-plan-items", "path": "/js-plan", "viewports": ["desktop", "phone"], "themes": ["light"], "waitFor": "table[aria-label=\"Current state per repo\"]:has-text(\"acme/web\")"},
    {"name": "journey-plan-filed", "path": "/js-plan-done", "viewports": ["desktop"], "themes": ["light"], "waitFor": "table[aria-label=\"Plan items\"] a:has-text(\"JS-PF-1\")"},
    {"name": "journey-usage-limit", "path": "/js-usage", "viewports": ["desktop"], "themes": ["light"], "waitFor": ":text(\"Waiting for usage limits to reset, earliest 2099-01-01 14:00 UTC\")"},
    {"name": "journey-step-provider", "path": "/js-provider", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".step-card:has-text(\"Architecture review\") .step-card__provider-select--override"},
    {"name": "journey-live-feed", "path": "/js-live", "viewports": ["desktop"], "themes": ["light"], "waitFor": ".activity-row__text:has-text(\"completed “Plan options & trade-offs (pros / cons)”\")"},
    {"name": "journey-plan-pill", "path": "/js-pf-1", "viewports": ["desktop", "phone"], "themes": ["light"], "waitFor": "a:has-text(\"From Plan JS-PLAN-DONE · 1 of 3 done\")"},
    {"name": "journey-plan-board", "path": "/?plan=JS-PLAN-DONE", "viewports": ["desktop", "phone"], "themes": ["light"], "waitFor": ".board__plan-chip:has-text(\"JS-PLAN-DONE\")"},
    {"name": "journey-farm-health", "path": "/farm-health", "viewports": ["desktop", "phone"], "themes": ["light"], "waitFor": "[aria-label=\"Overall\"][data-state=\"red\"]", "mask": [".farm-health__refresh", ".farm-health__overall-meta", ".farm-health__card--box", ".farm-health__svc-count", ".farm-health__services", ".farm-health__event-at"]}
  ]
}
