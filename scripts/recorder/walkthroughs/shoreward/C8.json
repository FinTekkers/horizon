    {"action": "waitFor", "selector": ".step:has(.step-card__label:text-is(\"Review the work & close\")) .btn-gate-approve", "timeoutMs": 30000},
    {"action": "pause", "ms": 1500},
    {"action": "click", "selector": ".step:has(.step-card__label:text-is(\"Review the work & close\")) .btn-gate-approve"},
    {"action": "waitFor", "selector": "[role=\"alertdialog\"] button.composer__submit"},
    {"action": "pause", "ms": 800},
    {"action": "click", "selector": "[role=\"alertdialog\"] button.composer__submit"},
    {"action": "pause", "ms": 3000}
  ]
