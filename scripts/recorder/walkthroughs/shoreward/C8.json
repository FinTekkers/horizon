{
  "setup": [
    {"action": "goto", "path": "/horizon/"},
    {"action": "waitFor", "selector": ".card:has-text(\"find-comps.mjs\")", "timeoutMs": 30000},
    {"action": "click", "selector": ".card:has-text(\"find-comps.mjs\")"},
    {"action": "waitFor", "selector": ".tracker", "timeoutMs": 30000}
  ],
  "actions": [
