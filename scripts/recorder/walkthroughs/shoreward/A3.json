{
  "setup": [
    {"action": "goto", "path": "/"},
    {"action": "waitFor", "selector": "a:has-text(\"Get access\"), button:has-text(\"Get access\")", "timeoutMs": 30000},
    {"action": "click", "selector": "a:has-text(\"Get access\"), button:has-text(\"Get access\")"},
    {"action": "waitFor", "selector": "#su-name", "timeoutMs": 30000},
    {"action": "type", "selector": "#su-name", "text": "Parvati", "delayMs": 60},
    {"action": "typeEnv", "selector": "#su-email", "env": "SHOREWARD_TENANT_EMAIL", "delayMs": 120},
    {"action": "type", "selector": "#su-company", "text": "Parvati Real Estate", "delayMs": 60},
    {"action": "click", "selector": "#su-terms"},
    {"action": "click", "selector": "#signup-submit"},
    {"action": "waitUntil", "selector": "#signup-checkout iframe", "timeoutMs": 120000}
  ],
  "actions": [
    {"action": "caption", "text": "Pay with a promotion code", "ms": 3500},
    {"action": "waitUntil", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> button:has-text(\"Add promotion code\")", "timeoutMs": 120000},
    {"action": "pause", "ms": 1500},
    {"action": "click", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> button:has-text(\"Add promotion code\")"},
    {"action": "waitFor", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> #promotionCode", "timeoutMs": 30000},
    {"action": "pause", "ms": 600},
    {"action": "typeEnv", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> #promotionCode", "env": "SHOREWARD_PROMO_CODE", "delayMs": 150},
    {"action": "pause", "ms": 600},
    {"action": "click", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> button:has-text(\"Apply\")"},
    {"action": "pause", "ms": 3000},
    {"action": "click", "selector": "#signup-checkout iframe >> internal:control=enter-frame >> button[type=\"submit\"]"},
    {"action": "waitUntil", "selector": "body:has-text(\"Welcome\")", "timeoutMs": 300000},
    {"action": "pause", "ms": 3000}
  ]
}
