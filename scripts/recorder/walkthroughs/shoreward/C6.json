    {"action": "click", "selector": "[role=\"alertdialog\"] button.composer__submit"},
    {"action": "waitFor", "selector": ".step:has(.step-card__label:text-is(\"Specialist agent implements\")) :text(\"In progress\")", "timeoutMs": 60000},
