    {"action": "waitFor", "selector": ".card:has-text(\"Find comparable sales for an Upper West Side co-op\")", "timeoutMs": 30000},
    {"action": "click", "selector": ".card:has-text(\"Find comparable sales for an Upper West Side co-op\")"},
