    {"action": "waitUntil", "selector": ".step:has(.step-card__label:text-is(\"Approve the run\")) .btn-gate-approve", "timeoutMs": 7200000, "reloadEveryMs": 60000},
    {"action": "pause", "ms": 2000},
    {"action": "followLink", "selector": ".step:has(.step-card__label:text-is(\"Run plan\")) a.step-card__artifact-link"},
