{
  "name": "horizon-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test ${HORIZON_TEST_REPORT_DIR:+--test-reporter=tap --test-reporter-destination=stdout --test-reporter=./scripts/junit-reporter.mjs --test-reporter-destination=$HORIZON_TEST_REPORT_DIR/server.xml} \"test/*.test.mjs\"",
