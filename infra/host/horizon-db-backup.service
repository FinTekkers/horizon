[Unit]
Description=Nightly online backup of the Horizon database (HZ-650)
Documentation=file:///opt/horizon/infra/host/DEPLOY.md
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
# Must match the DB path horizon-server uses (check /etc/horizon/server.env for
# a HORIZON_DB override before enabling; see DEPLOY.md 2k). No secrets here.
Environment=HORIZON_DB=/opt/horizon/server/data/horizon.db
Environment=HORIZON_BACKUP_DIR=/home/ubuntu/backups/horizon-db
ExecStart=/opt/horizon/infra/host/horizon-db-backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
