[Unit]
Description=Horizon agent farm (farmd)
After=network.target horizon-server.service

[Service]
# HZ-714: systemd runs farmd itself. Every farm.env setting reaches it through
# EnvironmentFile (not a filtered copy on a tmux command line), and its output
# goes to the journal: journalctl -fu horizon-farm.
Type=simple
User=ubuntu
WorkingDirectory=/opt/horizon
EnvironmentFile=/etc/horizon/farm.env
Environment=PYTHONUNBUFFERED=1
# venv, pip and the capture worker's npm ci; also stops a farm-daemon tmux
# session left by the old oneshot unit. pip and npm ci can be slow.
ExecStartPre=/opt/horizon/farm/run.sh prepare
ExecStart=/opt/horizon/farm/.venv/bin/python -m farm.farmd
TimeoutStartSec=600
Restart=on-failure
RestartSec=5
# Stop only the main process. The farm-run-*, farm-pm-* and farm-concierge-*
# agent sessions share the tmux server in this unit's cgroup; with the default
# control-group mode a restart killed every running agent step (2026-10-07
# deploy loop, HZ-321). The restarted farmd re-adopts the live sessions.
KillMode=process

[Install]
WantedBy=multi-user.target
