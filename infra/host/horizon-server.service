[Unit]
Description=Horizon server (Fastify + SQLite)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/horizon/server
EnvironmentFile=/etc/horizon/server.env
EnvironmentFile=-/etc/horizon/stripe.env
# HZ-633: Stripe live keys, provisioned by the owner. The leading `-` keeps the
# service booting while the file is missing; the billing routes answer 503.
EnvironmentFile=-/etc/horizon/stripe.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
# deploy-horizon.sh forks from this process to handle the webhook that triggers
# `systemctl restart horizon-server`; default KillMode=control-group would
# SIGTERM deploy.sh (and its git/npm children) along with the main process,
# killing the deploy before it reaches its own health check. KillMode=process
# limits the restart signal to the tracked main PID only.
KillMode=process

[Install]
WantedBy=multi-user.target
