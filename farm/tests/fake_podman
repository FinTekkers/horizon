#!/usr/bin/env python3
"""A stand-in for rootless `podman`, for hosts without it (HZ-416).

Only what farm/container_runner.py calls: `run -d`, `run --rm`, `exec`,
`kill`, `rm -f`, `ps -a`, `inspect`, `image exists` and `pull`. `run -d`
starts the given command (`sleep infinity`) on the host in its own session;
`exec` runs `sh -c <command>` on the host, in the host dir mounted at the
`-w` path, with only Podman's base variables plus the `--env` given to
`run` — so the HZ-407/408 suites exercise the container code path. `run
--rm` (HZ-502) runs its command the same way in the foreground and records
nothing. It does NOT confine
anything: mounts, read-only flags and limits are recorded, never enforced.
The confinement tests in test_container_runner.py need a real Podman.

Like rootless conmon, an exec'd command runs in its own session and
outlives a killed client: only `kill`/`rm -f` end it, and `ps -a` lists the
container until `rm -f`. Containers are recorded under
$FARM_FAKE_PODMAN_DIR/<name>.json. An image whose name contains "missing"
cannot be pulled; `pull` sleeps FAKE_PODMAN_PULL_DELAY seconds first.
`cat /sys/fs/cgroup/memory.events` prints `oom_kill <n>`, n read from
$FARM_FAKE_PODMAN_DIR/<name>.oom (0 when absent).
In an image whose name contains "nobash", `sh -c "command -v bash"` exits 1.
HZ-769: $FARM_FAKE_PODMAN_IMAGE_ENV, a JSON object, is the image's own `ENV`:
every container starts with it, under any `--env`. A bare `--env NAME`
passes the client's value on, in `run --rm` as in `run -d`.
HO-840: `network create|rm|ls` keep a record per network under
$FARM_FAKE_PODMAN_DIR/<name>.network (FAKE_PODMAN_NETWORK_FAIL=1 makes
`create` fail); `inspect` shows each `--network=<name>` with a fake IP
(`inspect --format <template> <name>` prints one "<network> <ip>" line
each); `logs <name>` prints $FARM_FAKE_PODMAN_DIR/<name>.log; `info` names netavark as
the network backend. A `run -d` labelled `horizon.egress=1` (the rehearsal's
egress proxy) sleeps FAKE_PODMAN_EGRESS_DELAY seconds, then runs `sleep
infinity` instead of its command, its log the proxy's ready line (none with
FAKE_PODMAN_EGRESS_NEVER_READY=1) and then FAKE_PODMAN_EGRESS_LOG.
"""

import json
import os
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

STATE = Path(os.environ.get("FARM_FAKE_PODMAN_DIR") or Path(tempfile.gettempdir()) / "fake-podman")
BASE_ENV = {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "TERM": "xterm",
    "container": "podman",
}
SIZES = {"k": 1024, "m": 1024**2, "g": 1024**3}


def _image_env() -> dict:
    """HZ-769: the image's own ENV, from $FARM_FAKE_PODMAN_IMAGE_ENV."""
    return json.loads(os.environ.get("FARM_FAKE_PODMAN_IMAGE_ENV") or "{}")


VALUE_OPTS = ("--name", "--label", "--user", "--cpus", "--memory", "--memory-swap", "-v", "-w", "--env")


def _record(name):
    try:
        return json.loads((STATE / f"{name}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None


def _save(rec):
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / f"{rec['name']}.json").write_text(json.dumps(rec))


def _forget(name):
    """Drops the record, and the registry dir once it is empty — so the
    suite's tmp leak guard names any container a test left behind."""
    (STATE / f"{name}.json").unlink(missing_ok=True)
    (STATE / f"{name}.oom").unlink(missing_ok=True)
    (STATE / f"{name}.log").unlink(missing_ok=True)
    try:
        STATE.rmdir()
    except OSError:
        pass


def _started(pid):
    """The process's start time (/proc/<pid>/stat field 22), or None."""
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def _kill(name):
    rec = _record(name)
    if not rec:
        return False
    starts = rec.get("starts", {})
    for pid in [rec["pid"], *rec.get("execs", [])]:
        # A record outliving its process must never kill whatever reused the
        # pid. A gone leader is still tried: its group can outlive it.
        now = _started(pid)
        if now is not None and now != starts.get(str(pid)):
            continue
        try:
            os.killpg(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
    return True


def _host_dir(rec, workdir):
    for m in sorted(rec["mounts"], key=lambda m: len(m["dst"]), reverse=True):
        if workdir == m["dst"] or workdir.startswith(m["dst"] + "/"):
            return m["src"] + workdir[len(m["dst"]) :]
    return "/"


def _run(args):
    opts = {"detach": False, "name": None, "mounts": [], "workdir": "/", "env": [], "flags": [], "labels": []}
    i = 0
    while i < len(args):
        a = args[i]
        if not a.startswith("-"):
            break
        if a == "-d":
            opts["detach"] = True
        elif a in VALUE_OPTS:
            value = args[i + 1]
            i += 1
            if a == "--name":
                opts["name"] = value
            elif a == "-v":
                src, dst, mode = (value.split(":") + ["rw"])[:3]
                opts["mounts"].append({"src": src, "dst": dst, "mode": mode})
            elif a == "-w":
                opts["workdir"] = value
            elif a == "--env":
                opts["env"].append(value)
            elif a == "--label":
                opts["labels"].append(value)
            else:
                opts[a.lstrip("-")] = value
        else:
            opts["flags"].append(a)
        i += 1
    image, command = args[i], args[i + 1 :]
    try:
        if float(opts.get("cpus", "1")) <= 0:
            raise ValueError
        _bytes(opts.get("memory", "1g"))
    except (ValueError, KeyError):
        print("Error: invalid argument for --cpus or --memory", file=sys.stderr)
        return 125
    if "missing" in image:
        print(f"Error: {image}: image not known", file=sys.stderr)
        return 125
    if "--rm" in opts["flags"] and not opts["detach"]:
        # HZ-502: a one-shot `run --rm` (the Run plan requires check): runs
        # the command in the foreground and leaves no record behind.
        env = {**BASE_ENV, **_image_env()}
        for entry in opts["env"]:
            key, sep, value = entry.partition("=")
            if sep:
                env[key] = value
            elif key in os.environ:
                env[key] = os.environ[key]
        return subprocess.run(command, cwd=_host_dir(opts, opts["workdir"]), env=env, stdin=subprocess.DEVNULL).returncode
    name = opts["name"] or f"fake-{os.getpid()}"
    if _record(name):
        print(f"Error: the container name \"{name}\" is already in use", file=sys.stderr)
        return 125
    egress = "horizon.egress=1" in opts["labels"]
    if egress:
        # HO-840: the egress proxy's sidecar — its start-up, then its log.
        time.sleep(float(os.environ.get("FAKE_PODMAN_EGRESS_DELAY") or 0))
        command = ["sleep", "infinity"]
    env = {**BASE_ENV, **_image_env(), "HOSTNAME": name}
    for entry in opts["env"]:
        key, sep, value = entry.partition("=")
        if sep:
            env[key] = value
        elif key in os.environ:
            env[key] = os.environ[key]
    proc = subprocess.Popen(
        command, cwd="/", stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True
    )
    starts = {str(proc.pid): _started(proc.pid)}
    _save({**opts, "name": name, "image": image, "pid": proc.pid, "execs": [], "starts": starts, "container_env": env})
    if egress:
        ready = "" if os.environ.get("FAKE_PODMAN_EGRESS_NEVER_READY") == "1" else "egress_proxy ready\n"
        (STATE / f"{name}.log").write_text(ready + (os.environ.get("FAKE_PODMAN_EGRESS_LOG") or ""))
    print(name)
    return 0


def _exec(args):
    workdir = None
    i = 0
    while args[i].startswith("-"):
        if args[i] == "-w":
            workdir = args[i + 1]
            i += 1
        i += 1
    name, command = args[i], args[i + 1 :]
    rec = _record(name)
    if not rec:
        print(f"Error: no container with name or ID \"{name}\" found", file=sys.stderr)
        return 125
    if command == ["cat", "/sys/fs/cgroup/memory.events"]:
        try:
            count = int((STATE / f"{name}.oom").read_text().strip() or 0)
        except (OSError, ValueError):
            count = 0
        print(f"low 0\nhigh 0\nmax 0\noom {count}\noom_kill {count}")
        return 0
    if command == ["sh", "-c", "command -v bash"] and "nobash" in rec["image"]:
        return 1
    proc = subprocess.Popen(
        command, cwd=_host_dir(rec, workdir or rec["workdir"]), env=rec["container_env"], start_new_session=True
    )
    rec["execs"].append(proc.pid)
    rec.setdefault("starts", {})[str(proc.pid)] = _started(proc.pid)
    _save(rec)
    code = proc.wait()
    return 128 - code if code < 0 else code


def _bytes(memory):
    if memory[-1:].lower() in SIZES:
        return int(memory[:-1]) * SIZES[memory[-1].lower()]
    return int(memory)


def _inspect(name):
    rec = _record(name)
    if not rec:
        print(f"Error: no such object: \"{name}\"", file=sys.stderr)
        return 125
    mem_bytes = _bytes(rec.get("memory", "0"))
    print(json.dumps([{
        "Name": name,
        "ImageName": rec["image"],
        "HostConfig": {"NanoCpus": int(float(rec.get("cpus", "0")) * 1e9), "Memory": mem_bytes},
        "Mounts": [{"Source": m["src"], "Destination": m["dst"], "RW": m["mode"] != "ro"} for m in rec["mounts"]],
        "Config": {"Env": rec["env"], "User": rec.get("user")},
        "NetworkSettings": {"Networks": _networks_of(rec)},
    }]))
    return 0


def _inspect_networks(name):
    """HO-840: `inspect --format <template> <name>`. The only template the farm
    passes prints one "<network> <ip>" line per network."""
    rec = _record(name)
    if not rec:
        print(f"Error: no such object: \"{name}\"", file=sys.stderr)
        return 125
    for network, settings in _networks_of(rec).items():
        print(network, settings["IPAddress"])
    return 0


def _networks_of(rec) -> dict:
    """HO-840: each `--network=<name>` of the container, with a fake IP."""
    names = [f.split("=", 1)[1] for f in rec.get("flags", []) if f.startswith("--network=")]
    return {n: {"IPAddress": f"10.89.{i}.2"} for i, n in enumerate(names) if n not in ("none", "host")}


def _network(argv):
    """HO-840: `network create [flags] <name>`, `network rm [-f] <name>` and
    `network ls [--filter label=k=v] [--format ...]`."""
    if argv[:1] == ["create"]:
        if os.environ.get("FAKE_PODMAN_NETWORK_FAIL") == "1":
            print("Error: netavark: unable to create network", file=sys.stderr)
            return 125
        args, labels, flags = argv[1:], [], []
        i = 0
        while i < len(args) - 1:
            if args[i] == "--label":
                labels.append(args[i + 1])
                i += 2
                continue
            flags.append(args[i])
            i += 1
        name = args[-1]
        if (STATE / f"{name}.network").exists():
            print(f"Error: network name {name} already used", file=sys.stderr)
            return 125
        STATE.mkdir(parents=True, exist_ok=True)
        (STATE / f"{name}.network").write_text(json.dumps({"name": name, "labels": labels, "flags": flags}))
        print(name)
        return 0
    if argv[:1] == ["rm"]:
        name = argv[-1]
        path = STATE / f"{name}.network"
        if not path.exists():
            print(f"Error: unable to find network with name or ID {name}", file=sys.stderr)
            return 1
        path.unlink()
        try:
            STATE.rmdir()
        except OSError:
            pass
        return 0
    if argv[:1] == ["ls"]:
        wanted = [f[len("label=") :] for f, prev in zip(argv[1:], argv) if prev == "--filter" and f.startswith("label=")]
        for path in sorted(STATE.glob("*.network")) if STATE.is_dir() else []:
            rec = json.loads(path.read_text())
            if all(w in rec.get("labels", []) for w in wanted):
                print(rec["name"])
        return 0
    print(f"fake_podman: unsupported: network {argv}", file=sys.stderr)
    return 125


def _logs(name):
    """HO-840: a container's log, from $FARM_FAKE_PODMAN_DIR/<name>.log."""
    if not _record(name):
        print(f"Error: no container with name or ID \"{name}\" found", file=sys.stderr)
        return 125
    path = STATE / f"{name}.log"
    sys.stdout.write(path.read_text() if path.exists() else "")
    return 0


def main(argv):
    if argv[:2] == ["image", "exists"]:
        return 1 if "missing" in argv[2] or "pull-me" in argv[2] else 0
    if argv[:1] == ["pull"]:
        time.sleep(float(os.environ.get("FAKE_PODMAN_PULL_DELAY") or 0))
        if "missing" in argv[-1]:
            print(f"Error: initializing source docker://{argv[-1]}: manifest unknown", file=sys.stderr)
            return 125
        return 0
    if argv[:1] == ["run"]:
        return _run(argv[1:])
    if argv[:1] == ["exec"]:
        return _exec(argv[1:])
    if argv[:1] == ["kill"]:
        return 0 if _kill(argv[1]) else 125
    if argv[:2] == ["rm", "-f"]:
        _kill(argv[2])
        _forget(argv[2])
        return 0
    if argv[:2] == ["ps", "-a"]:
        # `--filter label=k=v`, as podman: only containers carrying that label.
        wanted = [f[len("label=") :] for f, prev in zip(argv[1:], argv) if prev == "--filter" and f.startswith("label=")]
        for path in sorted(STATE.glob("*.json")) if STATE.is_dir() else []:
            rec = _record(path.stem) or {}
            if all(w in rec.get("labels", []) for w in wanted):
                print(path.stem)
        return 0
    if argv[:1] == ["inspect"]:
        if argv[1] == "--format":
            return _inspect_networks(argv[3])
        return _inspect(argv[1])
    if argv[:1] == ["info"]:
        print("netavark")  # HO-840: the network backend farmd checks at boot
        return 0
    if argv[:1] == ["network"]:
        return _network(argv[1:])
    if argv[:1] == ["logs"]:
        return _logs(argv[-1])
    print(f"fake_podman: unsupported: {argv}", file=sys.stderr)
    return 125


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
