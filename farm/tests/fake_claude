#!/usr/bin/env python3
"""Stand-in for the claude CLI in farm tests: instant, deterministic, free.

Mimics `claude -p <prompt> --output-format json [...]`, emitting the same
JSON envelope. The "agent" fills empty fields it can see in the prompt.
"""
import json
import sys

args = sys.argv[1:]
prompt = args[args.index("-p") + 1] if "-p" in args else ""

sys_prompt = ""
if "--append-system-prompt" in args:
    sys_prompt = args[args.index("--append-system-prompt") + 1]

# WhatsApp concierge role: map trigger phrases in the message to the
# concierge JSON contract (including a disallowed action, for the
# gate-bypass drop test).
if "WhatsApp concierge" in sys_prompt:
    import re

    m = re.search(r'WhatsApp message from [^:]*: "(.*?)"', prompt, re.S)
    text = m.group(1) if m else ""
    low = text.lower()
    item_match = re.search(r"\b([A-Z]{2,4}-\d+)\b", text)
    item = item_match.group(1) if item_match else None
    actions = []
    if item and "priority" in low:
        priority = next((p for p in ("Critical", "High", "Medium", "Low") if p.lower() in low), "High")
        actions.append({"type": "set_priority", "item_id": item, "priority": priority})
    elif item and low.startswith("feedback"):
        actions.append({"type": "feedback", "item_id": item, "message": text.split(":", 1)[-1].strip()})
    elif item and "approve" in low:
        actions.append({"type": "approve_gate", "item_id": item})
    inner = {"reply": f"[fake-concierge] handled: {text[:60]}", "actions": actions}
    print(json.dumps({"type": "result", "result": json.dumps(inner), "session_id": "fake-session-001"}))
    sys.exit(0)

# HZ-44 real-subprocess regression: opt-in via a marker in the outcome text
# (never fires for an ordinary task) so this fake reproduces the exact HZ-43
# shape — an artifact_md that quotes raw JSON, breaking the reply's own JSON
# envelope — on the first call, then a clean reply once resumed. Exercises
# the real subprocess path (_run_claude_subprocess + extract_json + the
# retry in step_agent._run_and_parse), not a monkeypatched run_claude.
HZ44_QUOTE_BUG_SESSION = "fake-session-hz44-quote-bug"
if "--resume" in args and args[args.index("--resume") + 1] == HZ44_QUOTE_BUG_SESSION:
    good = '{"summary": "reviewed, ok", "artifact_md": "# Architecture review\\npass-with-notes"}'
    print(json.dumps({"type": "result", "result": good, "session_id": HZ44_QUOTE_BUG_SESSION}))
    sys.exit(0)
if "HZ44_QUOTE_BUG" in prompt:
    bad = (
        '{"summary": "reviewed", "artifact_md": "swap `{"items":[]}` for '
        '`{"ok":true,"itemCount":0}`..."}'
    )
    print(json.dumps({"type": "result", "result": bad, "session_id": HZ44_QUOTE_BUG_SESSION}))
    sys.exit(0)

patch = {}
if "guardrails: (empty)" in prompt and "Set guardrails" in prompt:
    patch["guardrails"] = "[fake] defaults apply; no destructive data changes"
if "success metric: (empty)" in prompt and "measure success" in prompt:
    patch["metric"] = "[fake] drafted measurable target"

step = "step"
for line in prompt.splitlines():
    if line.startswith("Step to perform now:"):
        step = line.split('"')[1] if '"' in line else "step"

inner = {"summary": f"[fake-claude] completed {step.lower()}", **({"patch": patch} if patch else {})}

# Ephemeral planner roles ask for an artifact; implement role edits files.
if "artifact_md" in sys_prompt:
    inner["artifact_md"] = f"# Fake artifact — {step}\n\n- point one\n- point two\n\n_Produced by fake_claude for testing._"
if "implementing an approved work item" in sys_prompt:
    import pathlib
    pathlib.Path("fake_implementation.txt").write_text(f"fake implementation for: {step}\n")

print(json.dumps({"type": "result", "result": json.dumps(inner), "session_id": "fake-session-001"}))
