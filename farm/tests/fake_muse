#!/usr/bin/env python3
"""Stand-in for `muse exec --json` in farm tests (HZ-489): plays a scripted
JSONL event stream with pauses, so a test can watch each event reach the farm
log while this process is still running. Ignores its argv.

FAKE_MUSE_SCENARIO names a JSON file:
    {"stderr_bytes": <n>,        # written to stderr before any event
     "steps": [{"pause_s": <s>, "event": {...}}, ...],
     "linger_s": <s>,            # sleep after the last event
     "exit": <code>}
FAKE_MUSE_EMIT_LOG names a file this appends to: "pid <pid>", then
"emit <index> <unix time>" as each event is flushed, then "exit <unix time>".
"""
import json
import os
import sys
import time

scenario = json.load(open(os.environ["FAKE_MUSE_SCENARIO"]))
emit_log = open(os.environ["FAKE_MUSE_EMIT_LOG"], "a", buffering=1)
emit_log.write(f"pid {os.getpid()}\n")

if scenario.get("stderr_bytes"):
    sys.stderr.write("w" * scenario["stderr_bytes"])
    sys.stderr.flush()

for index, step in enumerate(scenario["steps"]):
    time.sleep(step.get("pause_s", 0))
    sys.stdout.write(json.dumps(step["event"]) + "\n")
    sys.stdout.flush()
    emit_log.write(f"emit {index} {time.time()}\n")

time.sleep(scenario.get("linger_s", 0))
emit_log.write(f"exit {time.time()}\n")
sys.exit(scenario.get("exit", 0))
