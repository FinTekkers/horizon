    { "case": "a path that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "path": 7 }] }, "valid": false },
    { "case": "HZ-769: an env name and a host config file are kept", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "GITHUB_TOKEN": "$GITHUB_TOKEN" }, "requires": [{ "tool": "gh" }, { "env": "GITHUB_TOKEN" }, { "env": "npm_config_cache" }, { "file": "/etc/horizon/stripe.env" }] }, "valid": true },
    { "case": "HZ-769: a file with .. passes the shape (the farm resolves it)", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/../shadow" }] }, "valid": true },
    { "case": "HZ-769: an env name written as a $ reference", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "$GITHUB_TOKEN" }] }, "valid": false },
    { "case": "HZ-769: an env name starting with a digit", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "1TOKEN" }] }, "valid": false },
    { "case": "HZ-769: an env name that reads as an option", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "--env" }] }, "valid": false },
    { "case": "HZ-769: a relative file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "etc/horizon/stripe.env" }] }, "valid": false },
    { "case": "HZ-769: a file with a newline", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/a\nb" }] }, "valid": false },
    { "case": "HZ-769: an env name that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": 7 }] }, "valid": false },
    { "case": "a service, all five precondition kinds and a written file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "service": { "name": "postgresql", "version_cmd": "psql --version", "expect": "psql (PostgreSQL) 16" } }, { "precondition": { "kind": "lock_free", "check": "flock -n /tmp/backfill.lock true" } }, { "precondition": { "kind": "no_deploy_running", "check": "pgrep -f deploy-horizon.sh 2>/dev/null" } }, { "precondition": { "kind": "row_exists", "check": "psql \"$RO_DB_URL\" -tAc 'SELECT 1 FROM accounts LIMIT 1'" } }, { "precondition": { "kind": "account_exists", "check": "psql \"$RO_DB_URL\" -tAc \"SELECT 1 FROM accounts WHERE id = 42\"" } }, { "precondition": { "kind": "artifact_exists", "check": "test -e /tmp/prices-2026-10-09.csv" } }, { "file": "/etc/horizon/app.env", "access": "w" }] }, "valid": true },
    { "case": "a file read, with access r", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": "r" }] }, "valid": true },
    { "case": "access x", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": "x" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access rw", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": "rw" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access R", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": "R" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access empty", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": "" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access true", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/app.env", "access": true }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access beside a tool", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "psql", "access": "r" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "access with no file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "access": "w" }] }, "valid": false, "reason": "run_plan 'requires' access must be 'r' or 'w', and only beside a 'file'" },
    { "case": "a precondition of an unknown kind", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": { "kind": "disk_free", "check": "df -h /" } }] }, "valid": false, "reason": "run_plan 'requires' precondition must be {\"kind\", \"check\"} and nothing else: kind one of lock_free, no_deploy_running, row_exists, account_exists, artifact_exists, and a one-line check" },
    { "case": "a precondition with no check", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": { "kind": "lock_free" } }] }, "valid": false, "reason": "run_plan 'requires' precondition must be {\"kind\", \"check\"} and nothing else: kind one of lock_free, no_deploy_running, row_exists, account_exists, artifact_exists, and a one-line check" },
    { "case": "a precondition with a blank check", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": { "kind": "lock_free", "check": "  " } }] }, "valid": false, "reason": "run_plan 'requires' precondition must be {\"kind\", \"check\"} and nothing else: kind one of lock_free, no_deploy_running, row_exists, account_exists, artifact_exists, and a one-line check" },
    { "case": "a precondition with a two-line check", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": { "kind": "lock_free", "check": "true\ntrue" } }] }, "valid": false, "reason": "run_plan 'requires' precondition must be {\"kind\", \"check\"} and nothing else: kind one of lock_free, no_deploy_running, row_exists, account_exists, artifact_exists, and a one-line check" },
    { "case": "a precondition that is a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": "lock_free" }] }, "valid": false, "reason": "run_plan 'requires' precondition must be {\"kind\", \"check\"} and nothing else: kind one of lock_free, no_deploy_running, row_exists, account_exists, artifact_exists, and a one-line check" },
    { "case": "a service with no expect", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "service": { "name": "postgresql", "version_cmd": "psql --version" } }] }, "valid": false, "reason": "run_plan 'requires' service must be {\"name\", \"version_cmd\", \"expect\"} and nothing else: a name like postgresql, a one-line version_cmd and a one-line expect" },
    { "case": "a service name that reads as an option", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "service": { "name": "-v", "version_cmd": "psql --version", "expect": "16" } }] }, "valid": false, "reason": "run_plan 'requires' service must be {\"name\", \"version_cmd\", \"expect\"} and nothing else: a name like postgresql, a one-line version_cmd and a one-line expect" },
    { "case": "a service version_cmd that writes a file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "service": { "name": "postgresql", "version_cmd": "psql --version > /tmp/hz835-sentinel", "expect": "16" } }] }, "valid": false, "reason": "run_plan 'requires' service version_cmd must be read-only, but it has a write shape (redirect)" },
    { "case": "a precondition check that removes a file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "precondition": { "kind": "lock_free", "check": "rm -f /tmp/hz835-sentinel.lock" } }] }, "valid": false, "reason": "run_plan 'requires' precondition check must be read-only, but it has a write shape (rm)" }
  ],
  "$comment4": "HZ-503. `proof`: what proves each metric line, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). Shape only: a whole `line`, and exactly one of `command` (a 1-based index into `commands`) or `report` (`<path>#<field>`, both non-empty, the path listed in `reports`), or HZ-770's `manual` (non-blank text naming the owner check).",
  "proof": [
    { "case": "no proof list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1 }, "valid": true },
    { "case": "an empty proof list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [] }, "valid": true },
    {
      "case": "a command proof and a report proof",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "command": 1 }, { "line": 2, "report": "/tmp/r.json#rows_written" }] },
      "valid": true
    },
    { "case": "a command proof naming the last command", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 2 }] }, "valid": true },
    { "case": "proof is an object, not a list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": { "line": 1, "command": 1 } }, "valid": false },
    {
      "case": "an entry with both sources",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "command": 1, "report": "/tmp/r.json#rows" }] },
      "valid": false
    },
    { "case": "an entry with neither source", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1 }] }, "valid": false },
    { "case": "an entry with no line", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "command": 1 }] }, "valid": false },
    { "case": "line 0", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 0, "command": 1 }] }, "valid": false },
    { "case": "a line sent as a string", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": "2", "command": 1 }] }, "valid": false },
    { "case": "a line sent as a bool", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": true, "command": 1 }] }, "valid": false },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 1, "note": "x" }] }, "valid": false },
    { "case": "command index 0", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 0 }] }, "valid": false },
    { "case": "a command index past the end", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 3 }] }, "valid": false },
    {
      "case": "a report with an empty field",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/r.json#" }] },
      "valid": false
    },
    {
      "case": "a report with an empty path",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "#rows" }] },
      "valid": false
    },
    {
      "case": "a report with no field part",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/r.json" }] },
      "valid": false
    },
    {
      "case": "a report path not listed in reports",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/other.json#rows" }] },
      "valid": false
    },
    { "case": "a manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "the owner compares the close on the vendor site" }] }, "valid": true },
    {
      "case": "a command, a report and a manual proof",
      "block": {
        "cwd": ".",
        "commands": ["echo hi", "./count.sh"],
        "budget_minutes": 1,
        "reports": ["/tmp/r.json"],
        "proof": [{ "line": 1, "command": 2 }, { "line": 2, "report": "/tmp/r.json#rows" }, { "line": 3, "manual": "the owner opens the published page" }]
      },
      "valid": true
    },
    { "case": "an empty manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "" }] }, "valid": false },
    { "case": "a whitespace-only manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "  \n " }] }, "valid": false },
    { "case": "a manual proof that is not text", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": true }] }, "valid": false },
    { "case": "an entry with a command and a manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 1, "manual": "the owner checks" }] }, "valid": false }
  ],
  "$comment5": "HZ-503, HZ-770. Coverage of the metric, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js unprovenLines, unprovenReason) and farm/tests/test_job_reports.py (domain/py/run_plan.py unproven_lines, unproven). Each case's block has `commands` [\"echo hi\", \"./count.sh\"] and `reports` [\"/tmp/r.json\"] plus the case's `proof`; a case with no `proof` key sends a block with none. `names` is every line the reason must name; empty means the proof covers the metric. `reason`, when present, is the exact text both bindings give.",
  "proof_coverage": [
    { "case": "every line once", "metric": "1. rows written\n2. failures listed", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 2 }], "names": [] },
    { "case": "no metric and no proof", "metric": "", "proof": [], "names": [] },
    { "case": "a line with no proof", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }], "names": [3] },
    { "case": "a line named twice", "metric": "1. a\n2. b", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }, { "line": 2, "command": 2 }], "names": [2] },
    { "case": "a line past the metric", "metric": "1. a", "proof": [{ "line": 1, "command": 1 }, { "line": 6, "command": 1 }], "names": [6] },
    { "case": "proof for an empty metric", "metric": "", "proof": [{ "line": 1, "command": 1 }], "names": [1] },
    {
      "case": "a missing line and a doubled one",
      "metric": "1. a\n2. b\n3. c",
      "proof": [{ "line": 1, "command": 1 }, { "line": 1, "command": 2 }, { "line": 2, "command": 1 }],
      "names": [3, 1]
    },
    {
      "case": "a deferred line is not numbered",
      "metric": "1. a\n2. b\nDeferred to a follow-up item (not in scope here): c",
      "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }, { "line": 3, "command": 1 }],
      "names": [3]
    },
    { "case": "no proof key at all", "metric": "1. a\n2. b\n3. c", "names": [1, 2, 3], "reason": "proof has no entry for metric lines 1, 2, 3" },
    { "case": "two separate gaps", "metric": "1. a\n2. b\n3. c\n4. d", "proof": [{ "line": 1, "command": 1 }, { "line": 3, "command": 2 }], "names": [2, 4], "reason": "proof has no entry for metric lines 2, 4" },
    { "case": "every line manual", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "manual": "the owner checks line 1" }, { "line": 2, "manual": "the owner checks line 2" }, { "line": 3, "manual": "the owner checks line 3" }], "names": [] },
    { "case": "a command, a report and a manual line", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "command": 2 }, { "line": 2, "report": "/tmp/r.json#rows" }, { "line": 3, "manual": "the owner opens the published page" }], "names": [] }
  ],
  "$comment6": "HZ-770. Impact review's `circular_proofs`, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js circularProofs) and farm/tests/test_job_reports.py (domain/py/run_plan.py check_circular). A case with no `value` key sends none. `lines` is the flagged lines in line order; null means the value is refused.",
  "circular_proofs": [
    { "case": "no key", "metric": "1. a\n2. b", "lines": [] },
    { "case": "an empty list", "metric": "1. a\n2. b", "value": [], "lines": [] },
    { "case": "two lines, out of order", "metric": "1. a\n2. b\n3. c\n4. d\n5. e", "value": [{ "line": 5, "reason": "re-reads the file the loader wrote" }, { "line": 3, "reason": "parses the loader's own output" }], "lines": [3, 5] },
    { "case": "not a list", "metric": "1. a", "value": { "line": 1, "reason": "x" }, "lines": null },
    { "case": "a blank reason", "metric": "1. a", "value": [{ "line": 1, "reason": "  " }], "lines": null },
    { "case": "no reason", "metric": "1. a", "value": [{ "line": 1 }], "lines": null },
    { "case": "an unknown key", "metric": "1. a", "value": [{ "line": 1, "reason": "x", "note": "y" }], "lines": null },
    { "case": "a line sent as a string", "metric": "1. a\n2. b", "value": [{ "line": "2", "reason": "x" }], "lines": null },
    { "case": "a line past the metric", "metric": "1. a\n2. b", "value": [{ "line": 3, "reason": "x" }], "lines": null }
  ],
  "$comment7": "HZ-814. `db_changes`: the tables Execute counts before and after the run, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). The connection is one of the plan's `env` values; each table matches domain/dbChanges.json `tableName`; 1 to `maxTables` distinct names; no other key.",
  "db_changes": [
    { "case": "no db_changes block", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" } }, "valid": true },
    { "case": "a table and a schema.table", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices", "public.positions"] } }, "valid": true },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices"], "dsn": "postgres://x" } }, "valid": false },
    { "case": "no tables key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL" } }, "valid": false },
    { "case": "an empty tables list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": [] } }, "valid": false },
    { "case": "51 tables", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11", "t12", "t13", "t14", "t15", "t16", "t17", "t18", "t19", "t20", "t21", "t22", "t23", "t24", "t25", "t26", "t27", "t28", "t29", "t30", "t31", "t32", "t33", "t34", "t35", "t36", "t37", "t38", "t39", "t40", "t41", "t42", "t43", "t44", "t45", "t46", "t47", "t48", "t49", "t50"] } }, "valid": false },
    { "case": "a table named twice", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices", "prices"] } }, "valid": false },
    { "case": "a connection not in env", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$OTHER_DATABASE_URL", "tables": ["prices"] } }, "valid": false },
    { "case": "a literal connection", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "postgres://user:pw@db/mdi", "tables": ["prices"] } }, "valid": false },
    { "case": "an injection-shaped table name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["a; drop table b"] } }, "valid": false },
    { "case": "a quoted table name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["\"prices\""] } }, "valid": false },
    { "case": "three name parts", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["db.public.prices"] } }, "valid": false },
    { "case": "a table that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": [7] } }, "valid": false },
    { "case": "db_changes is a list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": [] }, "valid": false }
  ],
  "$comment8": "HZ-815. `outputs`: the media files Execute copies into the item's store, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). At most domain/taskMedia.json `maxOutputs` entries of exactly `path` and `kind`; `kind` one of `kinds`; a non-blank path with no `..` part and no control character.",
  "outputs": [
    { "case": "no outputs list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1 }, "valid": true },
    { "case": "an empty outputs list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [] }, "valid": true },
    { "case": "a relative mp4, an absolute jpg and a home png", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/cut.mp4", "kind": "video" }, { "path": "/srv/media/poster.jpg", "kind": "image" }, { "path": "~/recordings/final/frame.png", "kind": "image" }] }, "valid": true },
    { "case": "a kind that is not video or image", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/notes.txt", "kind": "text" }] }, "valid": false },
    { "case": "a path with a .. part", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/../../etc/passwd", "kind": "image" }] }, "valid": false },
    { "case": "a path with a control character", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/cut\n.mp4", "kind": "video" }] }, "valid": false },
    { "case": "a blank path", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "  ", "kind": "video" }] }, "valid": false },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/cut.mp4", "kind": "video", "title": "Cut" }] }, "valid": false },
    { "case": "no kind", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "out/cut.mp4" }] }, "valid": false },
    { "case": "a path that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": 7, "kind": "video" }] }, "valid": false },
    { "case": "21 outputs", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": [{ "path": "f0.png", "kind": "image" }, { "path": "f1.png", "kind": "image" }, { "path": "f2.png", "kind": "image" }, { "path": "f3.png", "kind": "image" }, { "path": "f4.png", "kind": "image" }, { "path": "f5.png", "kind": "image" }, { "path": "f6.png", "kind": "image" }, { "path": "f7.png", "kind": "image" }, { "path": "f8.png", "kind": "image" }, { "path": "f9.png", "kind": "image" }, { "path": "f10.png", "kind": "image" }, { "path": "f11.png", "kind": "image" }, { "path": "f12.png", "kind": "image" }, { "path": "f13.png", "kind": "image" }, { "path": "f14.png", "kind": "image" }, { "path": "f15.png", "kind": "image" }, { "path": "f16.png", "kind": "image" }, { "path": "f17.png", "kind": "image" }, { "path": "f18.png", "kind": "image" }, { "path": "f19.png", "kind": "image" }, { "path": "f20.png", "kind": "image" }] }, "valid": false },
    { "case": "outputs is an object", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "outputs": { "path": "out/cut.mp4", "kind": "video" } }, "valid": false }
  ],
  "$comment9": "HO-835. The v2 `requires` entries above (`service`, `precondition`, a `file`'s `access`) and these `write_shapes`: each `check` sent as a `row_exists` precondition, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js writeShape, runPlanError) and farm/tests/test_job_reports.py (domain/py/run_plan.py write_shape, validate). `shape` is the name of the domain/runPlanContract.json `writeShapes` entry it trips, or null for a read-only check that must pass. Best-effort: a pass does not prove a command read-only.",
  "write_shapes": [
    { "case": "an unquoted > to a file", "check": "psql -tAc 'SELECT 1' > out.txt", "shape": "redirect" },
    { "case": "an unquoted >> to a log", "check": "psql -tAc 'SELECT 1' >> run.log", "shape": "redirect" },
    { "case": "tee", "check": "cat /etc/horizon/app.env | tee copy.env", "shape": "tee" },
    { "case": "rm", "check": "rm -f /tmp/backfill.lock", "shape": "rm" },
    { "case": "sudo", "check": "sudo -n cat /etc/horizon/app.env", "shape": "sudo" },
    { "case": "mv", "check": "mv a.csv b.csv", "shape": "mv" },
    { "case": "cp", "check": "cp a.csv b.csv", "shape": "cp" },
    { "case": "chmod", "check": "chmod 600 /etc/horizon/app.env", "shape": "chmod" },
    { "case": "pkill", "check": "pkill -f backfill", "shape": "kill" },
    { "case": "git push", "check": "git -C repo push origin main", "shape": "git-push" },
    { "case": "systemctl restart", "check": "systemctl restart horizon-server", "shape": "systemctl" },
    { "case": "curl -X POST", "check": "curl -fsS -X POST https://example.test/api/items", "shape": "curl-write" },
    { "case": "curl with a data body", "check": "curl -fsS -d '{}' https://example.test/api/items", "shape": "curl-write" },
    { "case": "a lowercase delete from", "check": "psql \"$RO_DB_URL\" -tAc 'delete from accounts where id = 1'", "shape": "sql-write" },
    { "case": "an UPDATE", "check": "psql \"$RO_DB_URL\" -tAc \"UPDATE accounts SET n = 1\"", "shape": "sql-write" },
    { "case": "a > inside single quotes", "check": "psql \"$RO_DB_URL\" -tAc 'SELECT 1 FROM t WHERE n > 0'", "shape": null },
    { "case": "a > inside double quotes", "check": "psql \"$RO_DB_URL\" -tAc \"SELECT 1 FROM t WHERE n > 0\"", "shape": null },
    { "case": "stderr to /dev/null", "check": "test -e /tmp/backfill.lock 2>/dev/null", "shape": null },
    { "case": "stderr to stdout", "check": "pgrep -f deploy-horizon.sh 2>&1", "shape": null },
    { "case": "stdout to /dev/null", "check": "pg_isready -q > /dev/null", "shape": null },
    { "case": "a read-only systemctl", "check": "systemctl is-active horizon-server", "shape": null },
    { "case": "a read-only curl", "check": "curl -fsS https://example.test/api/health", "shape": null },
    { "case": "a status of deleted", "check": "psql \"$RO_DB_URL\" -tAc \"SELECT count(*) FROM accounts WHERE status = 'deleted'\"", "shape": null }
  ],
  "$comment10": "HO-835. `rehearsal`: the dry run, limit, read-only env names and one expected sample per proof command, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js runPlanError, extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). `reason`, on an invalid case, is the exact text both bindings give: it names the field, never a value (no reason ever holds `hz835-sentinel`). The v2 `requires` cases carry `reason` the same way.",
  "rehearsal": [
    { "case": "a full rehearsal block", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "dry_run": "./backfill.sh --dry-run", "limit": 50, "ro_env": ["RO_DB_URL"], "samples": [{ "command": 2, "expect": "would update 50 rows in accounts" }] } }, "valid": true },
    { "case": "an empty rehearsal block", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": {} }, "valid": true },
    { "case": "a dry run only", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "dry_run": "./backfill.sh --dry-run" } }, "valid": true },
    { "case": "a sample of exactly the longest expect", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 1, "expect": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }] } }, "valid": true },
    { "case": "rehearsal is a list", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": [{ "dry_run": "./backfill.sh --dry-run", "limit": 50, "ro_env": ["RO_DB_URL"], "samples": [{ "command": 2, "expect": "would update 50 rows in accounts" }] }] }, "valid": false, "reason": "run_plan 'rehearsal' must be an object" },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "dry_run": "./backfill.sh --dry-run", "verbose": true } }, "valid": false, "reason": "run_plan 'rehearsal' has unknown field(s): verbose" },
    { "case": "a blank dry run", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "dry_run": " " } }, "valid": false, "reason": "run_plan 'rehearsal.dry_run' must be a one-line, non-blank command" },
    { "case": "limit true", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "limit": true } }, "valid": false, "reason": "run_plan 'rehearsal.limit' must be a whole number, at least 1" },
    { "case": "limit 1.5", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "limit": 1.5 } }, "valid": false, "reason": "run_plan 'rehearsal.limit' must be a whole number, at least 1" },
    { "case": "limit as a string", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "limit": "50" } }, "valid": false, "reason": "run_plan 'rehearsal.limit' must be a whole number, at least 1" },
    { "case": "limit 0", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "limit": 0 } }, "valid": false, "reason": "run_plan 'rehearsal.limit' must be a whole number, at least 1" },
    { "case": "limit holding text", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "limit": "hz835-sentinel" } }, "valid": false, "reason": "run_plan 'rehearsal.limit' must be a whole number, at least 1" },
    { "case": "ro_env repeats an env key", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "ro_env": ["RO_DB_URL", "DB_URL"] } }, "valid": false, "reason": "run_plan 'rehearsal.ro_env' name DB_URL is a live 'env' name; a read-only name must be a different one" },
    { "case": "ro_env repeats a name an env value references", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "ro_env": ["DATABASE_URL"] } }, "valid": false, "reason": "run_plan 'rehearsal.ro_env' name DATABASE_URL is a live 'env' name; a read-only name must be a different one" },
    { "case": "ro_env as a $ reference", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "ro_env": ["$RO_DB_URL"] } }, "valid": false, "reason": "run_plan 'rehearsal.ro_env' must be a list of distinct variable names like RO_DB_URL, with no `$`" },
    { "case": "ro_env with a name twice", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "ro_env": ["RO_DB_URL", "RO_DB_URL"] } }, "valid": false, "reason": "run_plan 'rehearsal.ro_env' must be a list of distinct variable names like RO_DB_URL, with no `$`" },
    { "case": "ro_env as a string", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "ro_env": "RO_DB_URL" } }, "valid": false, "reason": "run_plan 'rehearsal.ro_env' must be a list of distinct variable names like RO_DB_URL, with no `$`" },
    { "case": "samples as an object", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": { "command": 1, "expect": "x" } } }, "valid": false, "reason": "run_plan 'rehearsal.samples' must be a list of {\"command\": <k>, \"expect\": \"<one expected line>\"} objects" },
    { "case": "a sample with no expect", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 2 }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' must be a list of {\"command\": <k>, \"expect\": \"<one expected line>\"} objects" },
    { "case": "a sample for a command the plan does not have", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 3, "expect": "x" }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' command must be a 1-based index into 'commands'" },
    { "case": "a sample command of true", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": true, "expect": "x" }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' command must be a 1-based index into 'commands'" },
    { "case": "two samples for one command", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 2, "expect": "a" }, { "command": 2, "expect": "b" }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' names command 2 more than once" },
    { "case": "a two-line expect", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 2, "expect": "a\nb" }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' expect must be one non-blank line of at most 200 characters" },
    { "case": "an expect one character too long", "block": { "cwd": ".", "commands": ["./backfill.sh --limit 50", "./count.sh"], "budget_minutes": 5, "env": { "DB_URL": "$DATABASE_URL" }, "rehearsal": { "samples": [{ "command": 2, "expect": "hz835-sentinelxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }] } }, "valid": false, "reason": "run_plan 'rehearsal.samples' expect must be one non-blank line of at most 200 characters" }
  ],
  "$comment11": "HO-843. command_hash: a command's sha256 hex, asserted by BOTH server/test/run-plan-patch.test.mjs (server/src/store.js commandHashesOf) and farm/tests/test_job_reports.py (farm/task_job.py command_hash_of), so an approved per-command hash is one Execute accepts. literal_secrets: the secret shape names each text holds, asserted by server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js literalSecrets) and farm/tests/test_job_reports.py (domain/py/run_plan.py literal_secrets). Each text is its parts joined, so no whole credential-shaped string sits in the repo.",
