{
  "$comment": "HZ-434. Run plan blocks with and without a `reports` list, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate), so a plan the Approve the run card accepts is one Execute accepts too. Both bindings check shape only plus no `..` part; where a report may live is Execute's realpath check.",
  "reports": [
    { "case": "no reports list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1 }, "valid": true },
    { "case": "an empty reports list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": [] }, "valid": true },
    {
      "case": "a relative path and an absolute /tmp path",
      "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": ["out/run.json", "/tmp/mdi-51-run1.json"] },
      "valid": true
    },
    { "case": "reports is a string, not a list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": "out/run.json" }, "valid": false },
    { "case": "an empty path", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": [""] }, "valid": false },
    { "case": "a path that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": [7] }, "valid": false },
    { "case": "a relative path with ..", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": ["../secrets.json"] }, "valid": false },
    {
      "case": "an absolute path with ..",
      "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "reports": ["/tmp/../opt/horizon/x.json"] },
      "valid": false
    }
  ],
  "$comment2": "HZ-416, HZ-491. Where Execute runs the plan. `runner` is the block's own field (null: absent); `withImage`/`withoutImage` are the effective runner in a repo with or without a pinned container image. Asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan + effectiveRunner) and farm/tests/test_container_runner.py (domain/py/run_plan.py validate, which applies no default).",
  "runner": [
    {
      "case": "no runner follows the repo's image",
      "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1 },
      "valid": true,
      "runner": null,
      "withImage": "container",
      "withoutImage": "host"
    },
    {
      "case": "an explicit container runner",
      "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "runner": "container" },
      "valid": true,
      "runner": "container",
      "withImage": "container",
      "withoutImage": "container"
    },
    {
      "case": "an explicit host runner",
      "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "runner": "host" },
      "valid": true,
      "runner": "host",
      "withImage": "host",
      "withoutImage": "host"
    },
    { "case": "an unknown runner", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "runner": "docker" }, "valid": false },
    { "case": "a non-string runner", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "runner": 7 }, "valid": false }
  ],
  "$comment3": "HZ-502. `requires`: the tools and checkout-relative paths a plan needs on its runner, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). A tool name never starts with `-`; a path is relative, with no `..` part and no control character. HZ-769: an `env` name is a variable name with no `$`; a `file` is absolute with no control character.",
  "requires": [
    { "case": "no requires list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1 }, "valid": true },
    { "case": "an empty requires list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [] }, "valid": true },
    { "case": "a tool and a root file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "grpcurl" }, { "path": "requirements.txt" }] }, "valid": true },
    { "case": "a tool with dots and plus, and a nested path", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "python3.12" }, { "tool": "g++" }, { "path": "src/app/config.yaml" }] }, "valid": true },
    { "case": "requires is a string, not a list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": "gh" }, "valid": false },
    { "case": "an item with both keys", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "gh", "path": "x" }] }, "valid": false },
    { "case": "an empty item", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{}] }, "valid": false },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "dir": "x" }] }, "valid": false },
    { "case": "an empty tool name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "" }] }, "valid": false },
    { "case": "a tool name with shell characters", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "x;rm -rf /" }] }, "valid": false },
    { "case": "a tool name that reads as an option", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "-v" }] }, "valid": false },
    { "case": "the paths marker as a tool name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "--paths" }] }, "valid": false },
    { "case": "a tool name with a trailing newline", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "tool": "gh\n" }] }, "valid": false },
    { "case": "an absolute path", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "path": "/etc/passwd" }] }, "valid": false },
    { "case": "a path with ..", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "path": "../secrets.json" }] }, "valid": false },
    { "case": "a path with a newline", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "path": "ok\nmissing" }] }, "valid": false },
    { "case": "a path that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "path": 7 }] }, "valid": false },
    { "case": "HZ-769: an env name and a host config file are kept", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "GITHUB_TOKEN": "$GITHUB_TOKEN" }, "requires": [{ "tool": "gh" }, { "env": "GITHUB_TOKEN" }, { "env": "npm_config_cache" }, { "file": "/etc/horizon/stripe.env" }] }, "valid": true },
    { "case": "HZ-769: a file with .. passes the shape (the farm resolves it)", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/../shadow" }] }, "valid": true },
    { "case": "HZ-769: an env name written as a $ reference", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "$GITHUB_TOKEN" }] }, "valid": false },
    { "case": "HZ-769: an env name starting with a digit", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "1TOKEN" }] }, "valid": false },
    { "case": "HZ-769: an env name that reads as an option", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": "--env" }] }, "valid": false },
    { "case": "HZ-769: a relative file", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "etc/horizon/stripe.env" }] }, "valid": false },
    { "case": "HZ-769: a file with a newline", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "file": "/etc/horizon/a\nb" }] }, "valid": false },
    { "case": "HZ-769: an env name that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "requires": [{ "env": 7 }] }, "valid": false }
  ],
  "$comment4": "HZ-503. `proof`: what proves each metric line, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). Shape only: a whole `line`, and exactly one of `command` (a 1-based index into `commands`) or `report` (`<path>#<field>`, both non-empty, the path listed in `reports`), or HZ-770's `manual` (non-blank text naming the owner check).",
  "proof": [
    { "case": "no proof list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1 }, "valid": true },
    { "case": "an empty proof list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [] }, "valid": true },
    {
      "case": "a command proof and a report proof",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "command": 1 }, { "line": 2, "report": "/tmp/r.json#rows_written" }] },
      "valid": true
    },
    { "case": "a command proof naming the last command", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 2 }] }, "valid": true },
    { "case": "proof is an object, not a list", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": { "line": 1, "command": 1 } }, "valid": false },
    {
      "case": "an entry with both sources",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "command": 1, "report": "/tmp/r.json#rows" }] },
      "valid": false
    },
    { "case": "an entry with neither source", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1 }] }, "valid": false },
    { "case": "an entry with no line", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "command": 1 }] }, "valid": false },
    { "case": "line 0", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 0, "command": 1 }] }, "valid": false },
    { "case": "a line sent as a string", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": "2", "command": 1 }] }, "valid": false },
    { "case": "a line sent as a bool", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": true, "command": 1 }] }, "valid": false },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 1, "note": "x" }] }, "valid": false },
    { "case": "command index 0", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 0 }] }, "valid": false },
    { "case": "a command index past the end", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 3 }] }, "valid": false },
    {
      "case": "a report with an empty field",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/r.json#" }] },
      "valid": false
    },
    {
      "case": "a report with an empty path",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "#rows" }] },
      "valid": false
    },
    {
      "case": "a report with no field part",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/r.json" }] },
      "valid": false
    },
    {
      "case": "a report path not listed in reports",
      "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "reports": ["/tmp/r.json"], "proof": [{ "line": 1, "report": "/tmp/other.json#rows" }] },
      "valid": false
    },
    { "case": "a manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "the owner compares the close on the vendor site" }] }, "valid": true },
    {
      "case": "a command, a report and a manual proof",
      "block": {
        "cwd": ".",
        "commands": ["echo hi", "./count.sh"],
        "budget_minutes": 1,
        "reports": ["/tmp/r.json"],
        "proof": [{ "line": 1, "command": 2 }, { "line": 2, "report": "/tmp/r.json#rows" }, { "line": 3, "manual": "the owner opens the published page" }]
      },
      "valid": true
    },
    { "case": "an empty manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "" }] }, "valid": false },
    { "case": "a whitespace-only manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": "  \n " }] }, "valid": false },
    { "case": "a manual proof that is not text", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "manual": true }] }, "valid": false },
    { "case": "an entry with a command and a manual proof", "block": { "cwd": ".", "commands": ["echo hi", "./count.sh"], "budget_minutes": 1, "proof": [{ "line": 1, "command": 1, "manual": "the owner checks" }] }, "valid": false }
  ],
  "$comment5": "HZ-503, HZ-770. Coverage of the metric, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js unprovenLines, unprovenReason) and farm/tests/test_job_reports.py (domain/py/run_plan.py unproven_lines, unproven). Each case's block has `commands` [\"echo hi\", \"./count.sh\"] and `reports` [\"/tmp/r.json\"] plus the case's `proof`; a case with no `proof` key sends a block with none. `names` is every line the reason must name; empty means the proof covers the metric. `reason`, when present, is the exact text both bindings give.",
  "proof_coverage": [
    { "case": "every line once", "metric": "1. rows written\n2. failures listed", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 2 }], "names": [] },
    { "case": "no metric and no proof", "metric": "", "proof": [], "names": [] },
    { "case": "a line with no proof", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }], "names": [3] },
    { "case": "a line named twice", "metric": "1. a\n2. b", "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }, { "line": 2, "command": 2 }], "names": [2] },
    { "case": "a line past the metric", "metric": "1. a", "proof": [{ "line": 1, "command": 1 }, { "line": 6, "command": 1 }], "names": [6] },
    { "case": "proof for an empty metric", "metric": "", "proof": [{ "line": 1, "command": 1 }], "names": [1] },
    {
      "case": "a missing line and a doubled one",
      "metric": "1. a\n2. b\n3. c",
      "proof": [{ "line": 1, "command": 1 }, { "line": 1, "command": 2 }, { "line": 2, "command": 1 }],
      "names": [3, 1]
    },
    {
      "case": "a deferred line is not numbered",
      "metric": "1. a\n2. b\nDeferred to a follow-up item (not in scope here): c",
      "proof": [{ "line": 1, "command": 1 }, { "line": 2, "command": 1 }, { "line": 3, "command": 1 }],
      "names": [3]
    },
    { "case": "no proof key at all", "metric": "1. a\n2. b\n3. c", "names": [1, 2, 3], "reason": "proof has no entry for metric lines 1, 2, 3" },
    { "case": "two separate gaps", "metric": "1. a\n2. b\n3. c\n4. d", "proof": [{ "line": 1, "command": 1 }, { "line": 3, "command": 2 }], "names": [2, 4], "reason": "proof has no entry for metric lines 2, 4" },
    { "case": "every line manual", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "manual": "the owner checks line 1" }, { "line": 2, "manual": "the owner checks line 2" }, { "line": 3, "manual": "the owner checks line 3" }], "names": [] },
    { "case": "a command, a report and a manual line", "metric": "1. a\n2. b\n3. c", "proof": [{ "line": 1, "command": 2 }, { "line": 2, "report": "/tmp/r.json#rows" }, { "line": 3, "manual": "the owner opens the published page" }], "names": [] }
  ],
  "$comment6": "HZ-770. Impact review's `circular_proofs`, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js circularProofs) and farm/tests/test_job_reports.py (domain/py/run_plan.py check_circular). A case with no `value` key sends none. `lines` is the flagged lines in line order; null means the value is refused.",
  "circular_proofs": [
    { "case": "no key", "metric": "1. a\n2. b", "lines": [] },
    { "case": "an empty list", "metric": "1. a\n2. b", "value": [], "lines": [] },
    { "case": "two lines, out of order", "metric": "1. a\n2. b\n3. c\n4. d\n5. e", "value": [{ "line": 5, "reason": "re-reads the file the loader wrote" }, { "line": 3, "reason": "parses the loader's own output" }], "lines": [3, 5] },
    { "case": "not a list", "metric": "1. a", "value": { "line": 1, "reason": "x" }, "lines": null },
    { "case": "a blank reason", "metric": "1. a", "value": [{ "line": 1, "reason": "  " }], "lines": null },
    { "case": "no reason", "metric": "1. a", "value": [{ "line": 1 }], "lines": null },
    { "case": "an unknown key", "metric": "1. a", "value": [{ "line": 1, "reason": "x", "note": "y" }], "lines": null },
    { "case": "a line sent as a string", "metric": "1. a\n2. b", "value": [{ "line": "2", "reason": "x" }], "lines": null },
    { "case": "a line past the metric", "metric": "1. a\n2. b", "value": [{ "line": 3, "reason": "x" }], "lines": null }
  ],
  "$comment7": "HZ-814. `db_changes`: the tables Execute counts before and after the run, asserted by BOTH server/test/run-plan-reports-cases.test.mjs (domain/js/runPlan.js extractRunPlan) and farm/tests/test_job_reports.py (domain/py/run_plan.py validate). The connection is one of the plan's `env` values; each table matches domain/dbChanges.json `tableName`; 1 to `maxTables` distinct names; no other key.",
  "db_changes": [
    { "case": "no db_changes block", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" } }, "valid": true },
    { "case": "a table and a schema.table", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices", "public.positions"] } }, "valid": true },
    { "case": "an unknown key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices"], "dsn": "postgres://x" } }, "valid": false },
    { "case": "no tables key", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL" } }, "valid": false },
    { "case": "an empty tables list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": [] } }, "valid": false },
    { "case": "51 tables", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7", "t8", "t9", "t10", "t11", "t12", "t13", "t14", "t15", "t16", "t17", "t18", "t19", "t20", "t21", "t22", "t23", "t24", "t25", "t26", "t27", "t28", "t29", "t30", "t31", "t32", "t33", "t34", "t35", "t36", "t37", "t38", "t39", "t40", "t41", "t42", "t43", "t44", "t45", "t46", "t47", "t48", "t49", "t50"] } }, "valid": false },
    { "case": "a table named twice", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["prices", "prices"] } }, "valid": false },
    { "case": "a connection not in env", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$OTHER_DATABASE_URL", "tables": ["prices"] } }, "valid": false },
    { "case": "a literal connection", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "postgres://user:pw@db/mdi", "tables": ["prices"] } }, "valid": false },
    { "case": "an injection-shaped table name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["a; drop table b"] } }, "valid": false },
    { "case": "a quoted table name", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["\"prices\""] } }, "valid": false },
    { "case": "three name parts", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": ["db.public.prices"] } }, "valid": false },
    { "case": "a table that is not a string", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": { "connection": "$MDI_DATABASE_URL", "tables": [7] } }, "valid": false },
    { "case": "db_changes is a list", "block": { "cwd": ".", "commands": ["echo hi"], "budget_minutes": 1, "env": { "DATABASE_URL": "$MDI_DATABASE_URL" }, "db_changes": [] }, "valid": false }
  ]
}
