{
  "title": "Horizon productivity report",
  "description": "HZ-549: the 200 response of GET /api/admin/productivity, read by Admin's Productivity page. One file feeds the route's serializer, the published OpenAPI spec and the contract test. Cost and token fields are nullable: null means 'not captured', which the UI shows as 'Not captured yet', never 0. Per-project values are arrays of {project, ...}, not maps. Every object lists all its keys in required and forbids extras, so a field the server forgets fails loudly instead of being dropped.",
  "type": "object",
  "required": ["source", "range", "project", "from", "to", "projects", "summary", "closedPerDay", "costPerDay", "topItems", "models", "cycleTime", "rework", "failures", "approvals"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "description": "'fixture' while the route serves domain/fixtures/productivity.json (HZ-549); 'live' once HZ-550 aggregates real data.",
      "type": "string",
      "enum": ["fixture", "live"]
    },
    "range": { "description": "The requested window, echoed back.", "type": "string", "enum": ["7d", "14d", "30d"] },
    "project": { "description": "The requested project id, or 'all', echoed back.", "type": "string", "minLength": 1 },
    "from": { "description": "First day in the window, YYYY-MM-DD.", "type": "string", "minLength": 10 },
    "to": { "description": "Last day in the window, YYYY-MM-DD, inclusive.", "type": "string", "minLength": 10 },
    "projects": {
      "description": "Every project that appears in the per-project series, in chip order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["closed", "steps", "modelCoverage", "cost", "costPerItem"],
      "additionalProperties": false,
      "properties": {
        "closed": { "description": "Items closed in the window.", "type": "integer", "minimum": 0 },
        "steps": { "description": "Step runs in the window.", "type": "integer", "minimum": 0 },
        "modelCoverage": { "description": "Share of step runs with a recorded model, 0 to 1.", "type": "number", "minimum": 0, "maximum": 1 },
        "cost": { "description": "Total token cost in USD. null = not captured.", "type": ["null", "number"], "minimum": 0 },
        "costPerItem": { "description": "Median token cost per closed item in USD. null = not captured.", "type": ["null", "number"], "minimum": 0 }
      }
    },
    "closedPerDay": {
      "description": "One entry per day in the window, oldest first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "byProject"],
        "additionalProperties": false,
        "properties": {
          "date": { "description": "YYYY-MM-DD.", "type": "string", "minLength": 10 },
          "byProject": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["project", "count"],
              "additionalProperties": false,
              "properties": {
                "project": { "description": "A projects[].id.", "type": "string", "minLength": 1 },
                "count": { "description": "Items closed that day.", "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "costPerDay": {
      "description": "One entry per day in the window, oldest first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "byProject"],
        "additionalProperties": false,
        "properties": {
          "date": { "description": "YYYY-MM-DD.", "type": "string", "minLength": 10 },
          "byProject": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["project", "cost", "inputTokens", "outputTokens"],
              "additionalProperties": false,
              "properties": {
                "project": { "description": "A projects[].id.", "type": "string", "minLength": 1 },
                "cost": { "description": "USD. null = not captured.", "type": ["null", "number"], "minimum": 0 },
                "inputTokens": { "description": "null = not captured.", "type": ["null", "integer"], "minimum": 0 },
                "outputTokens": { "description": "null = not captured.", "type": ["null", "integer"], "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "topItems": {
      "description": "Most expensive items closed in the window, most expensive first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "project", "steps", "tokens", "cost"],
        "additionalProperties": false,
        "properties": {
          "id": { "description": "Work item id, e.g. HZ-501.", "type": "string", "minLength": 1 },
          "kind": { "description": "Item kind from domain/steps.json (change, task, plan).", "type": "string", "minLength": 1 },
          "project": { "description": "A projects[].id.", "type": "string", "minLength": 1 },
          "steps": { "description": "Step runs, every attempt counted.", "type": "integer", "minimum": 0 },
          "tokens": { "description": "Input plus output tokens. null = not captured.", "type": ["null", "integer"], "minimum": 0 },
          "cost": { "description": "USD. null = not captured.", "type": ["null", "number"], "minimum": 0 }
        }
      }
    },
    "models": {
      "description": "The model x step matrix: one row per step label, one count per model in columns, plus the runs with no model recorded. An object of {columns, rows} rather than a bare array so the column order is part of the contract.",
      "type": "object",
      "required": ["columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "columns": { "description": "Model ids, in column order.", "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "runs", "notRecorded"],
            "additionalProperties": false,
            "properties": {
              "step": { "description": "Step label, or a grouped label such as 'Task steps (Assess → Verify)'.", "type": "string", "minLength": 1 },
              "runs": {
                "description": "One entry per columns[] model, same order.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["model", "count"],
                  "additionalProperties": false,
                  "properties": {
                    "model": { "type": "string", "minLength": 1 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "notRecorded": { "description": "Runs of this step with no model recorded.", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "cycleTime": {
      "type": "object",
      "required": ["byKind"],
      "additionalProperties": false,
      "properties": {
        "byKind": {
          "description": "Median time per closed item, split four ways, one entry per item kind.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "medianMinutes"],
            "additionalProperties": false,
            "properties": {
              "kind": { "description": "Item kind from domain/steps.json.", "type": "string", "minLength": 1 },
              "medianMinutes": {
                "type": "object",
                "required": ["agentsWorking", "waitingOnYou", "queued", "checksAndDeploy"],
                "additionalProperties": false,
                "properties": {
                  "agentsWorking": { "description": "An agent step was running.", "type": "number", "minimum": 0 },
                  "waitingOnYou": { "description": "Waiting on a human at a gate.", "type": "number", "minimum": 0 },
                  "queued": { "description": "Ready but not yet picked up by the farm.", "type": "number", "minimum": 0 },
                  "checksAndDeploy": { "description": "Checks running, merging and deploying.", "type": "number", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "rework": {
      "type": "object",
      "required": ["firstPassYield", "sendBacksPerItem", "reviewFailCyclesPerItem", "byRepo"],
      "additionalProperties": false,
      "properties": {
        "firstPassYield": { "description": "Share of closed items with no send-back and no failed review, 0 to 1.", "type": "number", "minimum": 0, "maximum": 1 },
        "sendBacksPerItem": { "description": "Mean human send-backs (request changes) per closed item.", "type": "number", "minimum": 0 },
        "reviewFailCyclesPerItem": { "description": "Mean failed automated-review cycles per closed item.", "type": "number", "minimum": 0 },
        "byRepo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "sendBacksPerItem", "reviewFailCyclesPerItem"],
            "additionalProperties": false,
            "properties": {
              "repo": { "description": "owner/name.", "type": "string", "minLength": 1 },
              "sendBacksPerItem": { "type": "number", "minimum": 0 },
              "reviewFailCyclesPerItem": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "failures": {
      "description": "Why steps fail, one entry per week (oldest first). Fixed camelCase keys rather than reason strings; each key's description names the source it counts.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "checksFailed", "ruleBlocks", "scopeViolations", "usageLimits", "providerFallbacks"],
        "additionalProperties": false,
        "properties": {
          "week": { "description": "Monday of the week, YYYY-MM-DD.", "type": "string", "minLength": 10 },
          "checksFailed": { "description": "Check runs that finished failing (the repo's required checks, not a step failure reason).", "type": "integer", "minimum": 0 },
          "ruleBlocks": { "description": "Steps that ended blocked by a project rule or guardrail (the step agent's `blocked` report, server/src/ruleBlock.js).", "type": "integer", "minimum": 0 },
          "scopeViolations": { "description": "Steps failed for writing outside their scope: reason read_only_violated or job_cwd_refused (domain/reasons.json).", "type": "integer", "minimum": 0 },
          "usageLimits": { "description": "Steps stopped by a provider usage limit: reason usage_limited (domain/reasons.json).", "type": "integer", "minimum": 0 },
          "providerFallbacks": { "description": "Steps that fell back from the chosen provider to another one (e.g. to muse-spark-1.3-contributor).", "type": "integer", "minimum": 0 }
        }
      }
    },
    "approvals": {
      "type": "object",
      "required": ["gates"],
      "additionalProperties": false,
      "properties": {
        "gates": {
          "description": "One entry per gate, in lifecycle order.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate", "approvedPerDay", "medianWaitMinutes", "queue"],
            "additionalProperties": false,
            "properties": {
              "gate": { "description": "Gate step number, or a kind-specific gate name such as 'Task run' or 'Plan file'.", "type": "string", "minLength": 1 },
              "approvedPerDay": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["date", "count"],
                  "additionalProperties": false,
                  "properties": {
                    "date": { "description": "YYYY-MM-DD.", "type": "string", "minLength": 10 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "medianWaitMinutes": { "description": "Median time from the gate opening to its approval. null = no approvals in the window.", "type": ["null", "number"], "minimum": 0 },
              "queue": { "description": "Items waiting at this gate right now.", "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
