{
  "phases": ["Plan", "Technical Plan", "Execute", "Deploy", "Review"],
  "kinds": {
    "change": {
      "label": "Change",
      "description": "A code change: plan, build, deploy and review.",
      "phases": ["Plan", "Technical Plan", "Execute", "Deploy", "Review"]
    },
    "task": {
      "label": "Task",
      "description": "A one-off run that waits for human approval before it acts.",
      "phases": ["Plan", "Plan the run", "Run", "Review"]
    },
    "plan": {
      "label": "Plan",
      "description": "A roadmap question turned into a reviewed, filed set of items across a project's repos.",
      "phases": ["Scope", "Inventory", "Design", "Draft", "File"]
    }
  },
  "lanes": {
    "trivial": {
      "itemKind": "change",
      "check": ["change.define-outcome", "change.define-success", "change.set-guardrails"],
      "skip": ["change.plan-options", "change.approve-design", "change.arch-review", "change.summarize-reviews"]
    }
  },
  "steps": [
    { "key": "change.define-outcome", "phase": 0, "kind": "agent", "agent": "PM", "label": "Define the outcome", "runsIn": "pm", "providerOverrideEligible": true },
    { "key": "change.define-success", "phase": 0, "kind": "agent", "agent": "PM", "label": "Define how we measure success", "runsIn": "pm", "providerOverrideEligible": true },
    { "key": "change.set-guardrails", "phase": 0, "kind": "agent", "agent": "Architect", "label": "Set guardrails", "runsIn": "pm", "providerOverrideEligible": true },
