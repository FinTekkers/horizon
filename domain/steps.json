      "key": "change.plan-options",
      "phase": 1,
      "kind": "agent",
      "agent": "Ensemble",
      "label": "Plan options & trade-offs (pros / cons)",
      "runsIn": "farm",
      "short": true,
      "workspaceMutating": false,
      "providerOverrideEligible": true,
      "providerLocked": false,
      "maxTurns": 40,
      "timeoutS": 1140
    },
    { "key": "change.approve-design", "phase": 1, "kind": "gate", "gate": "required", "label": "Approve the high-level design", "sendBackTo": "change.plan-options" },
    {
      "key": "change.draft-plan",
      "phase": 1,
      "kind": "agent",
      "agent": "Eng",
